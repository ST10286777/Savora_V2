<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipToPadding="false"
        android:layout_marginBottom="56dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Savora Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:src="@drawable/logo_savora"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Category Name Input -->
            <EditText
                android:id="@+id/etCategoryName"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:hint="Enter category name"
                android:textColor="@color/white"
                android:textColorHint="@color/primary_orange"
                android:backgroundTint="@color/primary_orange"
                app:layout_constraintTop_toBottomOf="@id/imgLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"
                android:padding="16dp" />

            <!-- Add Category Button -->
            <Button
                android:id="@+id/btnAddCategory"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Add Category"
                android:backgroundTint="@color/primary_orange"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/etCategoryName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Category List Title -->
            <TextView
                android:id="@+id/tvCategoryListTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Categories"
                android:textColor="@color/primary_orange"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/btnAddCategory"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp" />

            <!-- RecyclerView for Categories -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvCategoryListTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:background="@color/background_black" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
